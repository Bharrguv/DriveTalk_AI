# === LLM Provider (required) ===
# Use either OpenAI or Groq
OPENAI_API_KEY=sk-your-key-here
# GROQ_API_KEY=gsk_your-key-here

LLM_PROVIDER=openai          # openai | groq
LLM_MODEL=gpt-4o-mini        # openai: gpt-4o-mini / gpt-4o
                             # groq: llama-3.3-70b-versatile / llama-3.1-8b-instant

# === Dealership branding ===
DEALERSHIP_NAME=Apex Motors
DEALERSHIP_LOCATION=Downtown Service Center

# === TTS (edge-tts / Vocalize-style pipeline) ===
TTS_VOICE=en-US-JennyNeural  # other good ones: en-US-AriaNeural, en-GB-SoniaNeural
TTS_RATE=+0%                 # e.g. +10% or -5%
TTS_ENABLED=true

# === Voice loop (optional) ===
WHISPER_MODEL=base           # tiny | base | small | medium
